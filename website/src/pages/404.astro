---
// The page GitHub Pages serves for any address that isn't on the site. It's built here with
// Starlight's layout rather than from a 404.md in the docs collection, because Starlight also
// builds every collection entry as an ordinary page, and its /404/ would collide with this route.
// astro.config.mjs turns off Starlight's own 404 route for the same reason.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const page = (path: string) => `${base}${path}`;
---

<StarlightPage
  frontmatter={{
    title: "Page not found",
    description: "There's no page at this address. It may have moved when the docs were reorganised.",
    editUrl: false,
    pagefind: false,
    tableOfContents: false,
    prev: false,
    next: false,
  }}
>
  <p>
    There's no page at this address. The usage guide that used to live in the repository's <code>docs/</code>
    folder is now split across this site. Try one of these:
  </p>
  <ul>
    <li><a href={page("quickstart/")}>Quickstart</a> to install zquota and check your quota</li>
    <li><a href={page("windows/")}>Quota windows</a>, for what each window is and when it resets</li>
    <li><a href={page("guides/scripting/")}>Scripts and alerts</a> for JSON, cron and <code>--threshold</code></li>
    <li><a href={page("guides/troubleshooting/")}>Troubleshooting</a> for the errors zquota prints</li>
    <li>the <a href={page("reference/cli/")}>CLI reference</a> for every flag</li>
  </ul>
  <p>Or search with the box at the top of the page.</p>
</StarlightPage>
